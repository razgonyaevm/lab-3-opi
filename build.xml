<?xml version="1.0" encoding="UTF-8"?>
<project name="lab3-ant" default="compile" basedir=".">

    <!-- Загрузка параметров -->
    <property file="build.properties"/>
    <property environment="env"/>

    <!-- Время сборки -->
    <tstamp>
        <format property="TODAY" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tstamp>

    <!-- ==================== 1. COMPILE ==================== -->
    <target name="compile" description="Компиляция исходных кодов">
        <antcall target="native2ascii"/>
        <ant antfile="build-jar.xml" target="compile" inheritall="false">
            <property name="param.src" value="${src.dir}"/>
            <property name="param.classes" value="${build.dir}/classes"/>
        </ant>
    </target>

    <!-- ==================== 2. BUILD ==================== -->
    <target name="build" depends="compile" description="Компиляция и упаковка в JAR">
        <ant antfile="build-jar.xml" target="build" inheritall="false">
            <property name="param.src" value="${src.dir}"/>
            <property name="param.classes" value="${build.dir}/classes"/>
            <property name="param.name" value="${project.name}"/>
            <property name="param.main" value="${main.class}"/>
        </ant>
    </target>

    <!-- ==================== 3. CLEAN ==================== -->
    <target name="clean" description="Удаление скомпилированных и временных файлов">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
        <delete dir="${doc.dir}"/>
        <!-- Очищаем reports, но не удаляем саму папку -->
        <mkdir dir="${report.dir}"/>
        <delete includeemptydirs="true" quiet="true">
            <fileset dir="${report.dir}" includes="**/*"/>
        </delete>
        <echo message="[CLEAN] Очистка завершена"/>
    </target>

    <!-- ==================== 4. TEST ==================== -->
    <target name="test" depends="compile-test" description="Запуск JUnit-тестов">
        <mkdir dir="${report.dir}/junit"/>
        <junit printsummary="yes" haltonfailure="no" fork="yes">
            <classpath>
                <pathelement path="${build.dir}/classes"/>
                <pathelement path="${build.dir}/test-classes"/>
                <fileset dir="${lib.dir}">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>
            <formatter type="xml"/>
            <batchtest todir="${report.dir}/junit">
                <fileset dir="${build.dir}/test-classes">
                    <include name="**/*Test.class"/>
                </fileset>
            </batchtest>
        </junit>
        <echo message="[TEST] Тесты выполнены. Отчёты: ${report.dir}/junit"/>
    </target>

    <!-- ===== Компиляция тестов, так как они лежат в test/java ===== -->
    <target name="compile-test" depends="build">
        <mkdir dir="${build.dir}/test-classes"/>
        <javac srcdir="${test.dir}"
               destdir="${build.dir}/test-classes"
               source="${compiler.source}"
               target="${compiler.target}"
               includeantruntime="false"
               debug="true">
            <classpath>
                <pathelement path="${build.dir}/classes"/>
                <fileset dir="${lib.dir}">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>
        </javac>
    </target>

    <!-- ==================== 5. DOC ==================== -->
    <target name="doc" depends="build" description="Javadoc + MD5/SHA-1 в MANIFEST.MF">
        <mkdir dir="${doc.dir}/javadoc"/>
        <javadoc sourcepath="${src.dir}"
                 destdir="${doc.dir}/javadoc"
                 author="true"
                 version="true"
                 windowtitle="${project.name} API">
            <classpath>
                <fileset dir="${lib.dir}">
                    <include name="**/*.jar"/>
                </fileset>
            </classpath>
        </javadoc>
        <checksum file="${dist.dir}/${project.name}.jar" algorithm="MD5" property="md5.hash"/>
        <checksum file="${dist.dir}/${project.name}.jar" algorithm="SHA-1" property="sha1.hash"/>
        <manifest file="${build.dir}/MANIFEST.MF" mode="update">
            <attribute name="MD5-Digest" value="${md5.hash}"/>
            <attribute name="SHA1-Digest" value="${sha1.hash}"/>
        </manifest>
        <jar destfile="${dist.dir}/${project.name}.jar"
             basedir="${build.dir}/classes"
             manifest="${build.dir}/MANIFEST.MF"
             update="true">
            <fileset dir="${doc.dir}" includes="javadoc/**"/>
        </jar>
        <echo message="[DOC] Javadoc и контрольные суммы добавлены"/>
    </target>

    <!-- ==================== 6. MUSIC ==================== -->
    <target name="music" depends="build" description="Воспроизведение музыки после сборки">
        <exec executable="afplay" os="Mac OS X">
            <arg value="${music.file}"/>
        </exec>
        <echo message="[MUSIC] Воспроизведение..."/>
    </target>

    <!-- ==================== 7. SCP ==================== -->
    <target name="scp" depends="build" description="Перемещение JAR по SCP на сервер">
        <tstamp>
            <format property="scp.timestamp" pattern="yyyy-MM-dd_HH-mm-ss"/>
        </tstamp>

        <exec executable="scp" failonerror="false" resultproperty="scp.result">
            <arg line="${scp.ssh.options}"/>
            <arg value="-P"/>
            <arg value="${scp.port}"/>
            <arg value="${dist.dir}/${project.name}.jar"/>
            <arg value="${scp.user}@${scp.server}:${scp.path}/${project.name}-${scp.timestamp}.jar"/>
        </exec>
        <condition property="scp.ok">
            <equals arg1="${scp.result}" arg2="0"/>
        </condition>
        <antcall target="scp-success"/>
        <antcall target="scp-failed"/>
    </target>

    <target name="scp-success" if="scp.ok">
        <echo message="[SCP] Файл отправлен: ${project.name}-${scp.timestamp}.jar"/>
    </target>

    <target name="scp-failed" unless="scp.ok">
        <echo message="[SCP] Не удалось отправить файл (код ${scp.result}). Проверьте SSH-ключ для ${scp.user}@${scp.server}"/>
    </target>

    <!-- ==================== 8. NATIVE2ASCII ==================== -->
    <target name="native2ascii" description="Преобразование файлов локализации">
        <mkdir dir="${native.dest.dir}"/>
        <native2ascii src="${native.src.dir}"
                      dest="${native.dest.dir}"
                      includes="*.properties"
                      ext=".properties"
                      encoding="UTF-8"/>
        <echo message="[NATIVE2ASCII] Файлы локализации преобразованы"/>
    </target>

    <!-- ==================== 9. XML ==================== -->
    <target name="xml" description="Валидация всех XML-файлов в проекте">
        <xmlvalidate lenient="yes">
            <fileset dir="." includes="**/*.xml"
                      excludes=".idea/**,apache-ant-*/**,build/**,dist/**,doc/**,repo/**,svn_test/build/**"/>
        </xmlvalidate>
        <echo message="[XML] Валидация XML завершена"/>
    </target>

    <!-- ==================== 10. REPORT ==================== -->
    <target name="report" depends="test" description="JUnit отчёт + commit в SVN">
        <exec executable="svn" dir="${svn.workdir}" failonerror="true">
            <arg value="add"/>
            <arg value="--parents"/>
            <arg value="--force"/>
            <arg value="${svn.report.path}"/>
        </exec>
        <exec executable="svn" dir="${svn.workdir}" failonerror="true">
            <arg value="commit"/>
            <arg value="-m"/>
            <arg value="JUnit test report"/>
            <arg value="${svn.report.path}"/>
        </exec>
        <echo message="[REPORT] Отчёт сохранён и закоммичен в SVN"/>
    </target>

    <!-- ==================== 11. ALT ==================== -->
    <target name="alt" description="Альтернативная версия с заменой имён">
        <mkdir dir="${build.dir}/alt/src"/>
        <copy todir="${build.dir}/alt/src">
            <fileset dir="${src.dir}"/>
        </copy>
        <replace dir="${build.dir}/alt/src" token="${replace.class.original}" value="${replace.class.new}"/>
        <replace dir="${build.dir}/alt/src" token="${replace.variable.original}" value="${replace.variable.new}"/>
        <move file="${build.dir}/alt/src/com/areaapp/${replace.class.original}.java"
              tofile="${build.dir}/alt/src/com/areaapp/${replace.class.new}.java"
              failonerror="false"/>

        <!-- Вызов build-jar.xml с альтернативными параметрами -->
        <ant antfile="build-jar.xml" target="build" inheritall="false">
            <property name="param.src" value="${build.dir}/alt/src"/>
            <property name="param.classes" value="${build.dir}/alt/classes"/>
            <property name="param.name" value="${project.name}-alt"/>
            <property name="param.main" value="${replace.main.class}"/>
        </ant>
        <echo message="[ALT] Альтернативная версия создана: ${dist.dir}/${project.name}-alt.jar"/>
    </target>

    <!-- Подготовка альтернативных исходников -->
    <target name="prepare-alt">
        <mkdir dir="${build.dir}/alt/src"/>
        <copy todir="${build.dir}/alt/src">
            <fileset dir="${original.src.dir}"/>
        </copy>

        <replace dir="${build.dir}/alt/src" token="${replace.class.original}" value="${replace.class.new}"/>
        <replace dir="${build.dir}/alt/src" token="${replace.variable.original}" value="${replace.variable.new}"/>

        <move file="${build.dir}/alt/src/com/areaapp/${replace.class.original}.java"
              tofile="${build.dir}/alt/src/com/areaapp/${replace.class.new}.java"
              failonerror="false"/>
    </target>

    <!-- ==================== 12. HISTORY ====================
         Если compile падает — откатываемся к предыдущей ревизии svn и пробуем снова.
         Когда сборка удалась — формируется diff между этой ревизией и следующей за ней
         (т.е. той, на которой всё ломалось). -->
    <target name="history" description="Откат по svn до рабочей ревизии + diff">
        <exec executable="svn" outputproperty="history.head.rev" failonerror="true">
            <arg value="info"/>
            <arg value="${svn.repo.url}"/>
            <arg value="--show-item"/>
            <arg value="revision"/>
        </exec>
        <echo message="[HISTORY] Стартовая ревизия: ${history.head.rev}"/>
        <mkdir dir="${dist.dir}"/>
        <ant antfile="${ant.file}" target="-history-loop" inheritall="false">
            <property name="current.rev" value="${history.head.rev}"/>
            <property name="broken.rev" value="${history.head.rev}"/>
        </ant>
    </target>

    <target name="-history-loop">
        <echo message="[HISTORY] Пробуем ревизию ${current.rev}"/>
        <exec executable="svn" dir="${svn.workdir}" failonerror="true">
            <arg value="update"/>
            <arg value="-r"/>
            <arg value="${current.rev}"/>
            <arg value="--accept"/>
            <arg value="theirs-full"/>
        </exec>
        <antcall target="-history-prepare-build"/>
        <exec executable="ant" dir="${svn.workdir}" resultproperty="history.compile.result" failonerror="false">
            <arg value="-f"/>
            <arg value="build.xml"/>
            <arg value="clean"/>
            <arg value="compile"/>
        </exec>
        <condition property="history.success">
            <equals arg1="${history.compile.result}" arg2="0"/>
        </condition>
        <antcall target="-history-on-success"/>
        <antcall target="-history-on-fail"/>
    </target>

    <target name="-history-prepare-build">
        <copy file="${ant.file}" tofile="${svn.workdir}/build.xml" overwrite="true"/>
        <copy file="${basedir}/build.properties" tofile="${svn.workdir}/build.properties" overwrite="true"/>
        <available file="${basedir}/build-jar.xml" property="history.has.build.jar"/>
        <antcall target="-history-copy-build-jar"/>
        <available file="${basedir}/${lib.dir}" type="dir" property="history.has.lib"/>
        <antcall target="-history-copy-lib"/>
    </target>

    <target name="-history-copy-build-jar" if="history.has.build.jar">
        <copy file="${basedir}/build-jar.xml" tofile="${svn.workdir}/build-jar.xml" overwrite="true"/>
    </target>

    <target name="-history-copy-lib" if="history.has.lib">
        <delete dir="${svn.workdir}/${lib.dir}" quiet="true"/>
        <copy todir="${svn.workdir}/${lib.dir}">
            <fileset dir="${basedir}/${lib.dir}"/>
        </copy>
    </target>

    <target name="-history-on-success" if="history.success">
        <echo message="[HISTORY] УСПЕХ на ревизии ${current.rev}"/>
        <condition property="history.has.broken">
            <not><equals arg1="${current.rev}" arg2="${broken.rev}"/></not>
        </condition>
        <antcall target="-history-make-diff"/>
    </target>

    <target name="-history-make-diff" if="history.has.broken">
        <exec executable="sh" outputproperty="next.rev">
            <arg value="-c"/>
            <arg value="echo $((${current.rev} + 1))"/>
        </exec>
        <echo message="[HISTORY] Формирую diff между r${current.rev} и r${next.rev}"/>
        <exec executable="svn" dir="${svn.workdir}" output="${history.diff.file}" failonerror="false">
            <arg value="diff"/>
            <arg value="-r"/>
            <arg value="${current.rev}:${next.rev}"/>
        </exec>
        <echo message="[HISTORY] Diff сохранён в ${history.diff.file}"/>
    </target>

    <target name="-history-on-fail" unless="history.success">
        <echo message="[HISTORY] Не удалось собрать на ревизии ${current.rev}"/>
        <condition property="history.is.first">
            <equals arg1="${current.rev}" arg2="1"/>
        </condition>
        <fail if="history.is.first" message="[HISTORY] Достигнута самая первая ревизия — ни одна не собирается"/>
        <exec executable="sh" outputproperty="prev.rev">
            <arg value="-c"/>
            <arg value="echo $((${current.rev} - 1))"/>
        </exec>
        <ant antfile="${ant.file}" target="-history-loop" inheritall="false">
            <property name="current.rev" value="${prev.rev}"/>
            <property name="broken.rev" value="${current.rev}"/>
        </ant>
    </target>

    <!-- ==================== 13. TEAM ====================
         Получает N (svn.previous.revisions) последних ревизий из svn, собирает каждую
         через build и упаковывает все jar-файлы в один zip-архив. -->
    <target name="team" description="Сборка N предыдущих ревизий и упаковка в zip">
        <delete dir="${team.dir}"/>
        <mkdir dir="${team.dir}"/>
        <mkdir dir="${dist.dir}"/>

        <!-- Получаем номер HEAD -->
        <exec executable="svn" outputproperty="team.head.rev" failonerror="true">
            <arg value="info"/>
            <arg value="${svn.repo.url}"/>
            <arg value="--show-item"/>
            <arg value="revision"/>
        </exec>
        <echo message="[TEAM] HEAD = ${team.head.rev}, берём ${svn.previous.revisions} ревизий"/>

        <exec executable="sh" failonerror="true">
            <arg value="-c"/>
            <arg value="rev=$((${team.head.rev} - 1)); left=${svn.previous.revisions}; while [ $left -gt 0 ] &amp;&amp; [ $rev -gt 0 ]; do echo '[TEAM] Сборка ревизии r'${rev}; rev_dir='${team.dir}/r'${rev}; rm -rf &quot;${rev_dir}&quot;; svn export -r ${rev} '${svn.repo.url}' &quot;${rev_dir}&quot;; [ -f build-jar.xml ] &amp;&amp; cp build-jar.xml &quot;${rev_dir}/build-jar.xml&quot;; [ -d lib ] &amp;&amp; cp -R lib &quot;${rev_dir}/lib&quot;; (cd &quot;${rev_dir}&quot; &amp;&amp; ant -f build.xml build) || true; if [ -d &quot;${rev_dir}/${dist.dir}&quot; ]; then for jar in &quot;${rev_dir}/${dist.dir}&quot;/*.jar; do [ -e &quot;${jar}&quot; ] &amp;&amp; cp &quot;${jar}&quot; '${team.dir}/'$(basename &quot;${jar}&quot; .jar)'-r'${rev}'.jar'; done; fi; rev=$((rev - 1)); left=$((left - 1)); done"/>
        </exec>

        <!-- Упаковываем все собранные jar в zip -->
        <zip destfile="${team.zip}">
            <fileset dir="${team.dir}" includes="*.jar"/>
        </zip>
        <echo message="[TEAM] Архив создан: ${team.zip}"/>
    </target>

    <!-- ==================== 14. ENV ====================
         Сборка и запуск jar в нескольких альтернативных окружениях.
         Окружения объявлены в build.properties: env.list, env.<name>.home, env.<name>.args.
         Для каждого окружения пересобираем jar нужной JDK и запускаем его с заданными
         JVM-аргументами. -->
    <target name="env" description="Сборка/запуск в альтернативных JDK">
        <!-- Универсальная цель: на каждое окружение из env.list — отдельный antcall -->
        <antcall target="-env-one">
            <param name="env.name" value="java17"/>
            <param name="env.java.home" value="${env.java17.home}"/>
            <param name="env.java.args" value="${env.java17.args}"/>
        </antcall>
        <antcall target="-env-one">
            <param name="env.name" value="java21"/>
            <param name="env.java.home" value="${env.java21.home}"/>
            <param name="env.java.args" value="${env.java21.args}"/>
        </antcall>
    </target>

    <target name="-env-one">
        <echo message="================================================"/>
        <echo message="[ENV] Окружение : ${env.name}"/>
        <echo message="[ENV] JAVA_HOME : ${env.java.home}"/>
        <echo message="[ENV] JVM args  : ${env.java.args}"/>
        <echo message="================================================"/>

        <!-- Проверяем, что такая JDK существует -->
        <available file="${env.java.home}/bin/javac" property="env.jdk.available"/>
        <fail unless="env.jdk.available"
              message="[ENV] JDK не найдена: ${env.java.home}"/>

        <!-- Печатаем версию -->
        <exec executable="${env.java.home}/bin/java" failonerror="false">
            <arg value="-version"/>
        </exec>

        <!-- Пересобираем под текущую JDK во временный каталог -->
        <property name="env.build.dir" value="${build.dir}/env/${env.name}"/>
        <property name="env.dist.jar" value="${dist.dir}/${project.name}-${env.name}.jar"/>
        <delete dir="${env.build.dir}"/>
        <mkdir dir="${env.build.dir}/classes"/>

        <javac srcdir="${src.dir}"
               destdir="${env.build.dir}/classes"
               source="${compiler.source}"
               target="${compiler.target}"
               includeantruntime="false"
               fork="true"
               executable="${env.java.home}/bin/javac"
               debug="true">
            <classpath>
                <fileset dir="${lib.dir}" includes="**/*.jar"/>
            </classpath>
        </javac>
        
        <!-- Копируем ресурсы, исключая оригинальные локали -->
        <copy todir="${env.build.dir}/classes">
            <fileset dir="${resources.dir}" excludes="**/*.java,locale/**"/>
        </copy>

        <!-- Преобразуем локали -->
        <native2ascii src="${resources.dir}/locale"
                      dest="${env.build.dir}/locale"
                      includes="*.properties"
                      ext=".properties"
                      encoding="UTF-8"/>

        <!-- Копируем преобразованные локали в классы -->
        <copy todir="${env.build.dir}/classes/locale" failonerror="false">
            <fileset dir="${env.build.dir}/locale"/>
        </copy>

        <manifest file="${env.build.dir}/MANIFEST.MF">
            <attribute name="Main-Class" value="${main.class}"/>
            <attribute name="Implementation-Version" value="${project.version}"/>
            <attribute name="Built-By" value="${user.name}"/>
            <attribute name="Build-Date" value="${TODAY}"/>
            <attribute name="Build-Env" value="${env.name}"/>
        </manifest>
        <jar destfile="${env.dist.jar}"
             basedir="${env.build.dir}/classes"
             manifest="${env.build.dir}/MANIFEST.MF"/>

        <echo message="[ENV] Запуск ${env.dist.jar} на ${env.name}..."/>
        <exec executable="${env.java.home}/bin/java" failonerror="false">
            <arg line="${env.java.args}"/>
            <arg value="-jar"/>
            <arg value="${env.dist.jar}"/>
        </exec>
    </target>

    <!-- ==================== 15. DIFF ==================== -->
    <target name="diff" description="Проверка изменений и commit в SVN">
        <exec executable="svn" dir="${svn.workdir}" outputproperty="svn.status" failonerror="true">
            <arg value="status"/>
        </exec>
        <echo message="SVN Status:${line.separator}${svn.status}"/>
        <condition property="svn.has.changes">
            <or>
                <contains string="${svn.status}" substring="M "/>
                <contains string="${svn.status}" substring="A "/>
                <contains string="${svn.status}" substring="D "/>
                <contains string="${svn.status}" substring="R "/>
            </or>
        </condition>
        <condition property="can.commit">
            <and>
                <isset property="svn.has.changes"/>
                <not>
                    <and>
                        <contains string="${svn.status}" substring="${diff.allowed.classes}"/>
                        <contains string="${svn.status}" substring="M "/>
                    </and>
                </not>
            </and>
        </condition>
        <antcall target="svn-commit-if-allowed"/>
        <antcall target="svn-skip-commit"/>
    </target>

    <target name="svn-commit-if-allowed" if="can.commit">
        <exec executable="svn" dir="${svn.workdir}" failonerror="true">
            <arg value="commit"/>
            <arg value="-m"/>
            <arg value="Auto-commit: changes outside protected classes"/>
        </exec>
        <echo message="[DIFF] Изменения закоммичены в SVN"/>
    </target>

    <target name="svn-skip-commit" unless="can.commit">
        <echo message="[DIFF] Commit пропущен (нет изменений, защищённый класс изменён или не SVN WC)"/>
    </target>
</project>
